source "Kconfig.zephyr"

menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP_TIME
    prompt "LED blink sleep time"
    default LED_BLINK_SLEEP_MEDIUM

config LED_BLINK_SLEEP_SLOW
    bool "2s (slow)"

config LED_BLINK_SLEEP_MEDIUM
    bool "1s (medium)"

config LED_BLINK_SLEEP_FAST
    bool "250ms (fast)"

endchoice

config BLINK_SLEEP_TIME_MS
    int
    default 250 if LED_BLINK_SLEEP_FAST
    default 1000 if LED_BLINK_SLEEP_MEDIUM
    default 2000 if LED_BLINK_SLEEP_SLOW
    default 0

menuconfig LED_ADVANCED
    bool "Advanced LED settings"

if LED_ADVANCED

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    default 100
    range 0 100

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    default 500
    range 0 10000

endif

menu "Expert settings"

config LED_DEBUG
    bool "Enable LED debugging"

config LED_CUSTOM_PATTERN
    bool "Custom blink pattern"

endmenu


endif